# From Supabase → Project Settings → API (or Connect dialog)
# Only these two belong in the React app:

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

# Do NOT put these in the frontend (.env):
# - service_role key (secret — bypasses all security)
# - database password (only for SQL Editor / migrations / direct Postgres)
